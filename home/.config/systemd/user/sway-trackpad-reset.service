[Unit]
Description=ログイン後に Magic Trackpad の入力を入れ直す（反応しない問題の対処）
PartOf=sway-session.target
After=sway-session.target

[Service]
Type=oneshot
# Apple Magic Trackpad (USB 05ac:0265) がログイン直後に反応しないことがある。
# トラックパッド側の電源を入れ直すと直るので、その代替として libinput 層で
# events を一度切って戻す。identifier を明示するのは、type:touchpad にすると
# 内蔵の ELAN タッチパッドまで巻き込むため。
# この identifier には USB の 2 インターフェース(if00/if01)が両方一致する。
ExecStart=/usr/bin/swaymsg -q input "1452:613:Apple_Inc._Magic_Trackpad" events disabled
ExecStart=/usr/bin/sleep 1
ExecStart=/usr/bin/swaymsg -q input "1452:613:Apple_Inc._Magic_Trackpad" events enabled

[Install]
WantedBy=sway-session.target
