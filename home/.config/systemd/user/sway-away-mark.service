[Unit]
Description=離席の開始時刻を記録する（未記録のときだけ）
# 既に記録があれば何もしない。暗転(300s)とサスペンド直前の両方から呼ばれるため。
ConditionPathExists=!%t/sway-away-since
PartOf=sway-session.target

[Service]
Type=oneshot
# 実時刻(epoch)で記録する。単調時計だとサスペンド中の経過が数えられない。
# %s は systemd の specifier なので %%s とエスケープする（さもないと文字列 "%s" が入る）。
ExecStart=/usr/bin/date +%%s
StandardOutput=file:%t/sway-away-since
