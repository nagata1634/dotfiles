[Unit]
Description=サスペンド直前の処理（蓋の判定と離席記録）
PartOf=sway-session.target

[Service]
Type=oneshot
# swayidle の before-sleep から同期で呼ばれる。logind は swayidle の delay inhibitor を
# 最大 5 秒待つので、ここが終わるまでサスペンドは始まらない。
ExecStart=/usr/bin/systemctl --user start sway-lid-logout.service
ExecStart=/usr/bin/systemctl --user start sway-away-mark.service
