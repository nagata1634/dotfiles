#!/usr/bin/env bash
# kde-snapshot — KDE Plasma の「設定・パネル・ウィジェット・ショートカット」を dotfiles に記録/復元する。
#
#   kde-snapshot save      実機の設定を ~/.dotfiles/home/.config/kde-snapshot/ にコピー（機種依存行を除去）
#   kde-snapshot restore   スナップショットを実機へ書き戻す（plasmashell を止めてコピー → 再起動）
#   kde-snapshot diff      実機とスナップショットの差分（何を変えたかの確認用）
#
# 方針: KDE が実行中に書き換えるファイルなので symlink ではなくコピーで扱う。壁紙画像のパスと
# データ系（統計・ウォレット）は記録しない。ショートカットと仮想デスクトップ数は KWin が終了時に
# メモリの状態で上書きするため、restore 後はログアウト→ログインで確定する。
# 設計の「なぜ」は ~/.dotfiles/CLAUDE.md「環境の再現」参照。
set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/.dotfiles}"
SNAP="$DOTFILES/home/.config/kde-snapshot"
TS="$(date +%Y%m%d-%H%M%S)"

# ~/.config からの相対パス。存在しないものは無視。
CONFIG_FILES=(
  plasma-org.kde.plasma.desktop-appletsrc   # パネル・ウィジェット・壁紙プラグイン
  plasmashellrc                              # スクリーン割り当て(ScreenConnectors)・パネル状態
  plasmarc                                   # Plasma テーマ
  plasmanotifyrc                             # 通知
  kwinrc                                     # KWin: 仮想デスクトップ, Krohnkite, Monitor Align, 装飾
  kwinoutputconfig.json                      # モニタ配置(同一機材前提)
  kglobalshortcutsrc                         # グローバルショートカット
  kdeglobals                                 # 外観(LnF, 配色, アイコン, フォント)
  kcminputrc kxkbrc                          # 入力・キーボード
  powerdevilrc kscreenlockerrc ksmserverrc   # 電源・ロック・セッション
  dolphinrc konsolerc spectaclerc katevirc kwriterc bluedevilglobalrc ktimezonedrc baloofilerc
)
# ~/.local/share からの相対パス(ディレクトリ可)
DATA_DIRS=(
  plasma_icons   # デスクトップの「アイコン」ウィジェットの実体(.desktop)
  konsole        # Konsole プロファイル
)

c_ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
c_warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die()    { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

# 保存時のサニタイズ: 壁紙画像パス(壁紙は復元しない)、Polonium 残骸
sanitize() {
  # 壁紙・ロック画面の画像パス(壁紙は復元しない)、Polonium 残骸、~/Pictures を指す行を落とす
  case "$1" in
    plasma-org.kde.plasma.desktop-appletsrc|kscreenlockerrc|plasmarc)
      sed -E -e '/^(Image|PreviewImage|usersWallpapers|UserWallpapers)=/d' -e '\#/Pictures/#d' ;;
    kwinrc) awk 'BEGIN{skip=0} /^\[/{skip=($0=="[Script-polonium]")} !skip && !/^poloniumEnabled=/{print}' ;;
    *) sed -e '\#/Pictures/#d' ;;
  esac
}

save() {
  mkdir -p "$SNAP/config" "$SNAP/share"
  local f n=0
  for f in "${CONFIG_FILES[@]}"; do
    [ -f "$HOME/.config/$f" ] || continue
    sanitize "$f" < "$HOME/.config/$f" > "$SNAP/config/$f"; n=$((n+1))
  done
  for f in "${DATA_DIRS[@]}"; do
    [ -d "$HOME/.local/share/$f" ] || continue
    rm -rf "$SNAP/share/$f"; cp -a "$HOME/.local/share/$f" "$SNAP/share/$f"
  done
  # 機密の混入チェック(公開リポジトリ)。PAM の "password" 行のような一般語は対象外にできないので目視も併用。
  if grep -rilE 'passwd=|token=|secret=|apikey|api_key' "$SNAP" >/dev/null; then
    grep -rilE 'passwd=|token=|secret=|apikey|api_key' "$SNAP"
    die "機密らしき行が含まれています。確認して除外してください"
  fi
  c_ok "保存: $n ファイル + $(ls "$SNAP/share" | wc -l) ディレクトリ → $SNAP"
  ( cd "$DOTFILES" && git status --short home/.config/kde-snapshot | head -20 )
}

restore() {
  [ -d "$SNAP/config" ] || die "スナップショットがありません: $SNAP"
  local f running=0
  if pgrep -x plasmashell >/dev/null; then running=1; kquitapp6 plasmashell 2>/dev/null || true; sleep 2; fi
  for f in "${CONFIG_FILES[@]}"; do
    [ -f "$SNAP/config/$f" ] || continue
    if [ -f "$HOME/.config/$f" ] && ! cmp -s "$SNAP/config/$f" "$HOME/.config/$f"; then
      cp -a "$HOME/.config/$f" "$HOME/.config/$f.bak.$TS"
    fi
    # 壁紙パスは実機の現在値を残す(スナップショットは持たない)
    if [ "$f" = plasma-org.kde.plasma.desktop-appletsrc ] && [ -f "$HOME/.config/$f" ]; then
      python3 - "$SNAP/config/$f" "$HOME/.config/$f" <<'PY'
import re,sys
snap,live=sys.argv[1],sys.argv[2]
imgs={}; sec=None
for l in open(live,encoding="utf-8"):
    if l.startswith("["): sec=l.strip()
    elif sec and l.startswith(("Image=","PreviewImage=")): imgs.setdefault(sec,[]).append(l)
out=[]; sec=None
for l in open(snap,encoding="utf-8"):
    if l.startswith("["):
        sec=l.strip(); out.append(l); out.extend(imgs.get(sec,[])); continue
    out.append(l)
open(live,"w",encoding="utf-8").write("".join(out))
PY
    else
      install -m 0600 "$SNAP/config/$f" "$HOME/.config/$f"
    fi
  done
  for f in "${DATA_DIRS[@]}"; do
    [ -d "$SNAP/share/$f" ] || continue
    mkdir -p "$HOME/.local/share/$f"; cp -a "$SNAP/share/$f/." "$HOME/.local/share/$f/"
  done
  [ "$running" = 1 ] && { kstart plasmashell >/dev/null 2>&1 & }
  qdbus-qt6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
  c_ok "復元しました（退避: ~/.config/*.bak.$TS）"
  c_warn "ショートカット・仮想デスクトップ数・出力配置は KWin が起動時に読むため、ログアウト→ログインで確定します"
}

diff_() {
  local f rc=0
  for f in "${CONFIG_FILES[@]}"; do
    [ -f "$SNAP/config/$f" ] || continue
    if ! sanitize "$f" < "$HOME/.config/$f" 2>/dev/null | diff -u --label "snapshot/$f" --label "live/$f" "$SNAP/config/$f" - ; then rc=1; fi
  done
  [ "$rc" = 0 ] && c_ok "差分なし"
  return $rc
}

case "${1:-}" in
  save) save ;;
  restore) restore ;;
  diff) diff_ ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
