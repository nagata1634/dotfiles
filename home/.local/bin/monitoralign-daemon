#!/usr/bin/env python3
"""monitoralign-daemon — モニタを横一列・隙間なしに並べ、縦オフセットだけを設定値で決める。

System Settings › KWin スクリプト › Monitor Align の設定ページ(kwinrc [Script-monitoralign]
y_<接続名>)を監視し、変更のたびに全モニタの position を kscreen-doctor へ1コマンドで適用する。
設定ページ(contents/config/main.xml と contents/ui/config.ui)は静的ファイルしか置けないため、
**いま有効なモニタだけを接続名で並べた内容をこのデーモンが生成する**(接続変化時も再生成)。
座標は kscreen-doctor -j の論理座標(pos)と、size/scale から求めた論理サイズだけを使う。
xrandr や ×scale の換算は使わない(過去に 769px の間隔が空いた原因)。

    monitoralign-daemon            常駐(systemd --user monitoralign.service)
    monitoralign-daemon --status   接続名 ↔ 現在の配置 ↔ 設定値を表示
    monitoralign-daemon --once     設定ページ生成と適用を1回だけ行って終了
"""
import json
import os
import subprocess
import sys
import time

CONF = os.path.expanduser("~/.config/kwinrc")
GROUP = "Script-monitoralign"
PKG = os.path.expanduser("~/.local/share/kwin/scripts/monitoralign/contents")
INTERNAL = ("eDP", "LVDS", "DSI")
POLL_MS = 10_000  # モニタの抜き差し検知(kscreen-doctor -j の軽い読み取り)


def log(msg):
    print(msg, flush=True)


def key(name):
    return "y_" + name.replace("-", "_")


def outputs():
    """有効な出力を [左から並べる順] で返す。各要素: name, x, y, w, h(論理px), portrait。"""
    data = json.loads(subprocess.check_output(["kscreen-doctor", "-j"]))
    outs = []
    for o in data["outputs"]:
        if not o["enabled"]:
            continue
        s = o["scale"]
        outs.append({
            "name": o["name"],
            "x": o["pos"]["x"], "y": o["pos"]["y"],
            # size は回転適用済みの物理px。KWin の論理サイズは scale で割って四捨五入
            "w": round(o["size"]["width"] / s), "h": round(o["size"]["height"] / s),
            "px": (o["size"]["width"], o["size"]["height"]),
            "priority": o["priority"],
        })
    outs.sort(key=lambda o: (not o["name"].startswith(INTERNAL), o["name"]))
    for o in outs:  # KDE の設定上の Primary(priority 最小)が基準。値は常に 0
        o["primary"] = o["priority"] == min(x["priority"] for x in outs)
    return outs


def offsets(outs):
    """Primary に対する相対値(px、正=下)。Primary 自身は 0。"""
    return [0 if o["primary"] else int(subprocess.run(
        ["kreadconfig6", "--file", "kwinrc", "--group", GROUP, "--key", key(o["name"]), "--default", "0"],
        capture_output=True, text=True).stdout.strip() or 0) for o in outs]


def layout(outs, ys):
    """純関数: 横一列・隙間なし。Y は設定値を正規化し、隣と縦に重なるようクランプ。"""
    n = len(outs)
    y = list(ys[:n]) + [0] * (n - len(ys[:n]))
    for i in range(1, n):  # 左から順に、直前のモニタと縦範囲が重なる範囲へ寄せる
        lo, hi = y[i - 1] - outs[i]["h"] + 1, y[i - 1] + outs[i - 1]["h"] - 1
        c = min(max(y[i], lo), hi)
        if c != y[i]:
            log(f"clamp: {outs[i]['name']} y={y[i]} -> {c} (隣と重なる範囲 {lo}..{hi})")
            y[i] = c
    m = min(y) if y else 0
    x, plan = 0, []
    for o, yy in zip(outs, y):
        plan.append((o["name"], x, yy - m))
        x += o["w"]
    return plan


HELP = (
    "Primary（KDE の「ディスプレイの設定」で決めたもの）を基準に、他のモニタを Primary より何 px 下に"
    "置くか（負 = 上へ）をスライダーか数値欄で決め、[適用] で反映します。"
    "境界をまたいでカーソルを横に動かし、飛ばなくなる所を探してください。"
    "隣へ移ったときカーソルが実際より上に出る → 出発側を下へ（値を増やす）、下に出る → 上へ。\n\n"
    "並びは左から下記の順（内蔵パネル → 外部の接続名順）で横一列・隙間なし。横方向は自動なので"
    "間隔が空くことはなく、隣と縦に重ならない値は自動で補正されます。"
)


def gen_ui(outs):
    """いま有効なモニタだけを接続名で並べた設定ページ(kcfg + .ui)を生成する。"""
    ent = "".join(f'    <entry name="{key(o["name"])}" type="Int"><label>{o["name"]}</label>'
                  f'<default>0</default></entry>\n' for o in outs)
    xml = ('<?xml version="1.0" encoding="UTF-8"?>\n'
           '<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">\n  <kcfgfile name=""/>\n'
           f'  <group name="">\n{ent}  </group>\n</kcfg>\n')
    lim = max((o["h"] for o in outs), default=1000)  # 隣の高さを超える値は意味が無い
    rows, conns = "", ""
    prim = next((o["name"] for o in outs if o["primary"]), "?")
    C = ' alignment="Qt::AlignHCenter"'
    for i, o in enumerate(outs):
        kind = "縦置き" if o["h"] > o["w"] else "横置き"
        k, sl, fine = key(o["name"]), f"slider_{i}", f"fine_{i}"  # fine: ±1 用の隠しスピンボックス
        title = f'{i+1}. {o["name"]}　{kind} {o["px"][0]}×{o["px"][1]}'

        def btn(name, text):
            return (f'      <item><widget class="QToolButton" name="{name}"><property name="text"><string>{text}</string></property>'
                    '<property name="autoRepeat"><bool>true</bool></property></widget></item>\n')
        if o["primary"]:  # 1行: 名前 ＋ 基準
            rows += (f'   <item{C}><widget class="QLabel" name="l{i}"><property name="text">'
                     f'<string>{title}　—　基準（Primary） 0 px</string></property></widget></item>\n')
            continue
        rows += (  # 3行: 名前 / スライダー / ステッパーと数値欄。すべて中央寄せ
            f'   <item{C}><widget class="QLabel" name="l{i}"><property name="text"><string>{title}</string></property></widget></item>\n'
            f'   <item{C}><widget class="QSlider" name="{sl}"><property name="orientation"><enum>Qt::Horizontal</enum></property>'
            '<property name="minimumWidth"><number>480</number></property>'
            f'<property name="minimum"><number>-{lim}</number></property><property name="maximum"><number>{lim}</number></property>'
            '<property name="singleStep"><number>10</number></property><property name="pageStep"><number>50</number></property>'
            '<property name="tickPosition"><enum>QSlider::TicksBelow</enum></property><property name="tickInterval"><number>100</number></property></widget></item>\n'
            f'   <item{C}><layout class="QHBoxLayout" name="h{i}">\n'
            + btn(f"m10_{i}", "−10") + btn(f"m1_{i}", "−1") +
            f'      <item><widget class="QSpinBox" name="kcfg_{k}"><property name="prefix"><string>{prim} より </string></property><property name="suffix"><string> px 下へ</string></property>'
            f'<property name="minimum"><number>-{lim}</number></property><property name="maximum"><number>{lim}</number></property>'
            '<property name="singleStep"><number>10</number></property></widget></item>\n'
            + btn(f"p1_{i}", "+1") + btn(f"p10_{i}", "+10") +
            f'      <item><widget class="QSpinBox" name="{fine}"><property name="maximumSize"><size><width>0</width><height>0</height></size></property>'
            f'<property name="minimum"><number>-{lim}</number></property><property name="maximum"><number>{lim}</number></property>'
            '<property name="singleStep"><number>1</number></property></widget></item>\n'
            '   </layout></item>\n'
            f'   <item><spacer name="gap{i}"><property name="orientation"><enum>Qt::Vertical</enum></property>'
            '<property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint"><size><width>0</width><height>12</height></size></property></spacer></item>\n')
        for src, dst in ((sl, f"kcfg_{k}"), (f"kcfg_{k}", sl), (fine, f"kcfg_{k}"), (f"kcfg_{k}", fine)):
            conns += (f'  <connection><sender>{src}</sender><signal>valueChanged(int)</signal>'
                      f'<receiver>{dst}</receiver><slot>setValue(int)</slot></connection>\n')
        for b_, dst, slot in ((f"m10_{i}", f"kcfg_{k}", "stepDown"), (f"p10_{i}", f"kcfg_{k}", "stepUp"),
                              (f"m1_{i}", fine, "stepDown"), (f"p1_{i}", fine, "stepUp")):
            conns += (f'  <connection><sender>{b_}</sender><signal>clicked()</signal>'
                      f'<receiver>{dst}</receiver><slot>{slot}()</slot></connection>\n')
    ui = ('<?xml version="1.0" encoding="UTF-8"?>\n<ui version="4.0">\n <class>MonitorAlignConfigForm</class>\n'
          ' <widget class="QWidget" name="MonitorAlignConfigForm">\n  <layout class="QVBoxLayout" name="v">\n'
          '   <item><widget class="QLabel" name="helpLabel"><property name="wordWrap"><bool>true</bool></property>'
          f'<property name="text"><string>{HELP}</string></property></widget></item>\n'
          f'{rows}'
          '   <item><spacer name="s"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>\n'
          f'  </layout>\n </widget>\n <resources/>\n <connections>\n{conns} </connections>\n</ui>\n')
    for rel, body in (("config/main.xml", xml), ("ui/config.ui", ui)):
        p = os.path.join(PKG, rel)
        if not os.path.exists(p) or open(p).read() != body:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w").write(body)
            log(f"設定ページ生成: {rel} ({', '.join(o['name'] for o in outs)})")


def kscreen(args):
    r = subprocess.run(["kscreen-doctor", *args], capture_output=True, text=True)
    out = r.stdout + r.stderr
    return r.returncode == 0 and "failed" not in out.lower(), out.strip()


def apply(quiet=False):
    outs = outputs()
    if not outs:
        return
    gen_ui(outs)
    plan = layout(outs, offsets(outs))
    cur = [(o["name"], o["x"], o["y"]) for o in outs]
    if plan == cur:
        quiet or log("変更なし: " + " ".join(f"{n}({x},{y})" for n, x, y in plan))
        return
    cmd = [f"output.{n}.position.{x},{y}" for n, x, y in plan]
    ok, out = kscreen(cmd)
    time.sleep(0.5)
    got = [(o["name"], o["x"], o["y"]) for o in outputs()]
    if ok and got == plan:
        log("適用: " + " ".join(cmd) + " / 照合OK")
        return
    log(f"適用失敗 ({out!r}); 読み戻し={got} 期待={plan}。直前の配置へ復帰します")
    ok, out = kscreen([f"output.{n}.position.{x},{y}" for n, x, y in cur])
    log("復帰: " + ("OK" if ok else f"失敗 {out!r}"))


def status():
    outs = outputs()
    for o, y in zip(outs, offsets(outs)):
        log(f"{o['name']:6} pos=({o['x']},{o['y']}) size={o['w']}x{o['h']}  設定 {key(o['name'])}={y}")


def main():
    if "--status" in sys.argv:
        return status()
    if "--once" in sys.argv:
        return apply()
    from PySide6.QtCore import QCoreApplication, QFileSystemWatcher, QTimer
    app = QCoreApplication(sys.argv)
    w = QFileSystemWatcher([CONF, os.path.dirname(CONF)])
    t = QTimer(singleShot=True, interval=300)  # KConfig は tmp+rename で書くので落ち着くまで待つ

    def changed(_=None):
        if CONF not in w.files() and os.path.exists(CONF):
            w.addPath(CONF)
        t.start()

    w.fileChanged.connect(changed)
    w.directoryChanged.connect(changed)
    t.timeout.connect(apply)
    poll = QTimer(interval=POLL_MS)  # 抜き差し: 出力集合や配置がプランからずれたら再適用
    poll.timeout.connect(lambda: apply(quiet=True))
    poll.start()
    apply()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
